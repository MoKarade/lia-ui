{
  "name": "@mokarade/lia-ui",
  "version": "0.36.0",
  "description": "LIA vivante : composant partagé du hub et des apps (corps de 100 traits, discussion, menu d'actions)",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoKarade/lia-ui.git"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./blocs": {
      "import": {
        "types": "./dist/blocs/index.d.mts",
        "default": "./dist/blocs/index.mjs"
      },
      "require": {
        "types": "./dist/blocs/index.d.ts",
        "default": "./dist/blocs/index.js"
      }
    },
    "./etat-http": {
      "import": {
        "types": "./dist/etat-http.d.mts",
        "default": "./dist/etat-http.mjs"
      },
      "require": {
        "types": "./dist/etat-http.d.ts",
        "default": "./dist/etat-http.js"
      }
    },
    "./package.json": "./package.json",
    "./boot": {
      "import": {
        "types": "./dist/boot.d.mts",
        "default": "./dist/boot.mjs"
      },
      "require": {
        "types": "./dist/boot.d.ts",
        "default": "./dist/boot.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
